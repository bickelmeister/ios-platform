# Gemeinsames Fastfile aller bickelmeister-iOS-Apps.
#
# Bewusst app-unabhängig: Projekt, Scheme, Marketingversion und Build-Nummer
# kommen aus der Umgebung, die ios-release.yml setzt. Damit ist diese Datei in
# allen Repos byte-identisch und kann von scripts/sync.sh verteilt werden.
# App-spezifisches steht im Appfile.
#
# MARKETING_VERSION/BUILD_NUMBER landen nur als Build-Parameter im Archiv, nie
# in project.pbxproj — main bleibt frei von automatisierten Commits.

default_platform(:ios)

platform :ios do
  desc "Archiviert, signiert und lädt den Build nach TestFlight"
  lane :release do
    project           = ENV.fetch("PROJECT")
    scheme            = ENV.fetch("SCHEME")
    marketing_version = ENV.fetch("MARKETING_VERSION")
    build_number      = ENV.fetch("BUILD_NUMBER")

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY"),
      is_key_content_base64: true,
      in_house: false
    )

    # Auf CI-Runnern gibt es keine entsperrte Login-Keychain; match legt sonst
    # einen interaktiven Prompt an und der Job hängt bis zum Timeout.
    setup_ci if is_ci

    match(
      type: "appstore",
      readonly: true,
      api_key: api_key
    )

    # Die Projekte stehen auf automatischem Signieren, damit die tägliche Arbeit
    # in Xcode reibungslos läuft. Für den Archive-Lauf muss das umgestellt
    # werden: Xcode würde sonst ein Development-Profil suchen, während match ein
    # AppStore-Profil installiert hat — und auf dem Runner kann es nichts
    # nachgenerieren. Die Werte kommen aus match, nicht aus dem Projekt, damit
    # dieses Fastfile in allen Apps identisch bleibt und die project.pbxproj
    # unangetastet bleibt.
    mapping = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
    app_identifier = mapping.keys.first
    profile_name = mapping[app_identifier]
    team_id = ENV.fetch("sigh_#{app_identifier}_appstore_team-id")

    build_app(
      project: project,
      scheme: scheme,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      clean: true,
      xcargs: [
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY='Apple Distribution'",
        "PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'",
        "DEVELOPMENT_TEAM='#{team_id}'",
        "MARKETING_VERSION=#{marketing_version}",
        "CURRENT_PROJECT_VERSION=#{build_number}"
      ].join(" ")
    )

    upload_to_testflight(
      api_key: api_key,
      # Der Build wird nur bereitgestellt; die Freigabe an Tester und der
      # Review-Antrag bleiben bewusst manuell in App Store Connect.
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
