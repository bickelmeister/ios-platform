# Gemeinsames Fastfile aller bickelmeister-iOS-Apps.
#
# Bewusst app-unabhängig: Projekt und Scheme kommen aus der Umgebung, die
# ios-release.yml setzt. Damit ist diese Datei in allen Repos byte-identisch und
# kann von scripts/sync.sh verteilt werden. App-spezifisches steht im Appfile.

default_platform(:ios)

platform :ios do
  desc "Archiviert, signiert und lädt den Build nach TestFlight"
  lane :release do
    project = ENV.fetch("PROJECT")
    scheme  = ENV.fetch("SCHEME")

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY"),
      is_key_content_base64: true,
      in_house: false
    )

    # Auf CI-Runnern gibt es keine entsperrte Login-Keychain; match legt sonst
    # einen interaktiven Prompt an und der Job hängt bis zum Timeout.
    setup_ci if is_ci

    match(
      type: "appstore",
      readonly: true,
      api_key: api_key
    )

    build_app(
      project: project,
      scheme: scheme,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      # Der Build wird nur bereitgestellt; die Freigabe an Tester und der
      # Review-Antrag bleiben bewusst manuell in App Store Connect.
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

  desc "Lädt die App-Store-Metadaten aus fastlane/metadata/ hoch (ohne Binary)"
  lane :metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY"),
      is_key_content_base64: true
    )

    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end
end
